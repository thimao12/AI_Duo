{
  "name": "desktop",
  "productName": "AI Duo",
  "version": "0.1.0",
  "description": "Claude × Codex – debate and pair-programming desktop app",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build": "pnpm --filter web build && node build.mjs",
    "start": "pnpm run build && electron .",
    "dist": "pnpm run build && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "local.aiduo.desktop",
    "productName": "AI Duo",
    "directories": { "output": "release" },
    "files": ["main.mjs", "link-handler.mjs", "shutdown.mjs", "preload.cjs", "build/icon.png", "dist/**"],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "AI-Duo-Setup-${version}.exe" },
    "portable": { "artifactName": "AI-Duo-${version}-portable.exe" }
  }
}
